#: src/main/help.c:300
msgid "show progress bar"
msgstr "arată bara de progres"

#: src/main/help.c:303
msgid "show elapsed time"
msgstr "arată timpul scurs"

#: src/main/help.c:306
msgid "show estimated time of arrival (completion)"
msgstr "arată timpul estimat de completare"

#: src/main/help.c:309
msgid "show absolute estimated time of arrival (completion)"
msgstr "arată timpul estimat de completare absolut"

#: src/main/help.c:312
msgid "show data transfer rate counter"
msgstr "arată numărătorul rății de transferare a datelor"

#: src/main/help.c:315
msgid "show data transfer average rate counter"
msgstr "arată numărătorul rății medii de transferare a datelor"

#: src/main/help.c:318
msgid "show number of bytes transferred"
msgstr "arată numărul de octeți transferați"

#: src/main/help.c:321
msgid "show percentage of transfer buffer in use"
msgstr "arată procentajul de uz al buffer-ului de transfer"

#: src/main/help.c:323
msgid "NUM"
msgstr "NUM"

#: src/main/help.c:324
msgid "show NUM bytes last written"
msgstr "arată NUM octeți ultimii scriși"

#: src/main/help.c:326
msgid "FORMAT"
msgstr "FORMAT"

#: src/main/help.c:327
msgid "set output format to FORMAT"
msgstr "setează formatul de ieșire ca FORMAT"

#: src/main/help.c:330
msgid "output percentages, not visual information"
msgstr "procentaje de ieșire, nu informație vizuală"

#: src/main/help.c:333
msgid "do not output any transfer information at all"
msgstr "nu trimite nici-o informație despre transfer către ieșire"

#: src/main/help.c:337
msgid "show number of bits transferred"
msgstr "arată numărul de bits transferați"

#: src/main/help.c:340
msgid "treat suffixes as multiples of 1000 rather than 1024"
msgstr "procesează suffixele ca multipli de 1000 în loc de 1024"

#: src/main/help.c:343
msgid "display nothing until first byte transferred"
msgstr "nu arăta nimic până când nu a fost transferat primul octet"

#: src/main/help.c:345 src/main/help.c:360 src/main/help.c:363
msgid "SEC"
msgstr "SEC"

#: src/main/help.c:346
msgid "display nothing until SEC seconds have passed"
msgstr "nu arăta nimic până când nu au trecut SEC secunde"

#: src/main/help.c:348
msgid "SIZE"
msgstr "VOLUM"

#: src/main/help.c:349
msgid "set estimated data size to SIZE bytes"
msgstr "setează volumul estimat al datelor ca VOLUM octeți"

#: src/main/help.c:352
msgid "if size unknown, show rate vs max rate"
msgstr "dacă volumul este necunoscut, arată rata vs. rata maximă"

#: src/main/help.c:355
msgid "count lines instead of bytes"
msgstr "numără rânduri în loc de octeți"

#: src/main/help.c:358
msgid "lines are null-terminated"
msgstr "rândurile sunt terminate-cu-null"

#: src/main/help.c:361
msgid "update every SEC seconds"
msgstr "actualizează la fiecare SEC secunde"

#: src/main/help.c:364
msgid "compute average rate over past SEC seconds (default 30s)"
msgstr "calculează rata medie asupra ultimelor SEC secunde (implicit 30s)"

#: src/main/help.c:366
msgid "WIDTH"
msgstr "LĂȚIME"

#: src/main/help.c:367
msgid "assume terminal is WIDTH characters wide"
msgstr "presupune că terminalul are lățimea de LĂȚIME litere"

#: src/main/help.c:369
msgid "HEIGHT"
msgstr "ÎNĂLȚIME"

#: src/main/help.c:370
msgid "assume terminal is HEIGHT rows high"
msgstr "presupune că terminalul are înălțimea de ÎNĂLȚIME rânduri"

#: src/main/help.c:372
msgid "NAME"
msgstr "NUME"

#: src/main/help.c:373
msgid "prefix visual information with NAME"
msgstr "prefixează informația vizuală cu NUME"

#: src/main/help.c:375
msgid "STYLE"
msgstr "STIL"

#: src/main/help.c:376
msgid "set default bar style to STYLE"
msgstr "setează stilul implicit al barei ca STIL"

#: src/main/help.c:378
msgid "SPEC"
msgstr "SPEC"

#: src/main/help.c:379
msgid "also send progress to SPEC"
msgstr "de-asemenea trimite progresul spre SPEC"

#: src/main/help.c:382
msgid "set terminal progress state with OSC 9;4 (ConEmu)"
msgstr "setează starea de progres a terminalului cu OSC 9;4 (ConEmu)"

#: src/main/help.c:385
msgid "output transfer statistics at the end"
msgstr "trimiti statistici de transfer către ieșire la final"

#: src/main/help.c:388
msgid "output even if standard error is not a terminal"
msgstr "trimite spre ieșire chiar dacă standard error nu este un terminal"

#: src/main/help.c:391
msgid "use cursor positioning escape sequences"
msgstr "folosește secvențe escape de poziționare a cursorului"

#: src/main/help.c:394 src/main/help.c:430 src/main/help.c:449
#: src/main/help.c:459
msgid "FILE"
msgstr "FIȘIER"

#: src/main/help.c:395
msgid "write output to FILE instead of stdout"
msgstr "trimite datele de ieșire spre FIȘIER în loc de stdout"

#: src/main/help.c:397
msgid "RATE"
msgstr "RATĂ"

#: src/main/help.c:398
msgid "limit transfer to RATE bytes per second"
msgstr "limitează transferul la RATĂ octeți pe secundă"

#: src/main/help.c:400 src/main/help.c:406 src/main/help.c:412
msgid "BYTES"
msgstr "OCTEȚI"

#: src/main/help.c:401
msgid "use a buffer size of BYTES"
msgstr "felosește un buffer cu volumul de OCTEȚI"

#: src/main/help.c:404
msgid "never use splice(), always use read/write"
msgstr "nu folosi vre-odată splice(), mereu folosește read/write"

#: src/main/help.c:407
msgid "set the pipe buffer size to BYTES"
msgstr "setează volumul pentru pipe buffer la OCTEȚI"

#: src/main/help.c:410
msgid "skip read errors in input"
msgstr "treci peste erorile de citire în datele de intrare"

#: src/main/help.c:413
msgid "skip errors in BYTES blocks at a time"
msgstr "treci peste erori in OCTEȚI blocuri de-odată"

#: src/main/help.c:416
msgid "stop after --size bytes have been transferred"
msgstr "opreștete după ce au fost transferați --size octeți"

#: src/main/help.c:419
msgid "flush cache to disk after every write"
msgstr "scrie memoria cache pe disk după fiecare citire"

#: src/main/help.c:422
msgid "use direct I/O to bypass cache"
msgstr "folosește I/O direct pentru a ocoli memoria cache"

#: src/main/help.c:425
msgid "try to seek instead of writing null bytes"
msgstr "încearcă să cauți în loc de a scrie octeți nuli"

#: src/main/help.c:428
msgid "discard input instead of writing to output"
msgstr "respinge datele de intrare în loc de a scrie către ieșire"

#: src/main/help.c:431
msgid "write all input to FILE before writing to output"
msgstr ""
"scrie toate datele de intrare către FIȘIER înainte de a scrie către ieșire"

#: src/main/help.c:434
msgid "PID[:FD]|=NAME|@LISTFILE"
msgstr "PID[:FD]|=NAME|@LISTFILE"

#: src/main/help.c:435
msgid "watch file FD opened by process PID"
msgstr "veghează fișierul FD deschis de procesul PID"

#: src/main/help.c:438 src/main/help.c:441
msgid "PID"
msgstr "PID"

#: src/main/help.c:439
msgid "update settings of process PID"
msgstr "actualizează setările procesului PID"

#: src/main/help.c:442
msgid "show progress of process PID"
msgstr "arată progresul procesului PID"

#: src/main/help.c:446
msgid "run a command and monitor its standard input, output, or both"
msgstr ""
"execută o comandă și monitorizează-i datele de intrare, de ieșire sau ambele"

#: src/main/help.c:450
msgid "save process ID in FILE"
msgstr "salvează procesul ID în FIȘIER"

#: src/main/help.c:453
msgid "show this help and exit"
msgstr "arată acest mesaj de ajutor și ieși din program"

#: src/main/help.c:456
msgid "show version information and exit"
msgstr "arată informația de versiune și ieși din program"

#: src/main/help.c:460
msgid "write debug logs to FILE"
msgstr "scrie debug logs către FIȘIER"

#: src/main/help.c:486
#, c-format
msgid "Usage: %s [OPTION] [FILE]..."
msgstr "Utilizare: %s [OPȚIUNE] [FIȘIER]..."

#: src/main/help.c:497
msgid ""
"Concatenate FILE(s), or standard input, to standard output, with monitoring."
msgstr ""
"Concatenează FIȘIER(e), sau datele de intrare. către ieșire, cu monitorizare."

#: src/main/help.c:639
msgid "Supported format sequences:"
msgstr "Secvențe de format suportate:"

#: src/main/help.c:653
#, c-format
msgid "Please report any bugs to: %s"
msgstr "Vă rugăm să raportați bug-uri către: %s"

#: src/main/main.c:225
msgid "(input)"
msgstr "(date de intrare)"

#: src/main/main.c:381 src/main/options.c:1359
msgid "a command to run must be specified"
msgstr "o comandă de executat trebuie specificată"

