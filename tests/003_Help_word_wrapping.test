#!/bin/sh
#
# Check that -h wraps words correctly on different terminal sizes.

error="not set - call this from 'make check'"
true "${sourcePath:?$error}"
true "${workDir:?$error}"
test -n "${sourcePath}" && . "${sourcePath}/tests/test-functions.sh"

# Timeout for each individual test.
generalTimeout='10'

# These tests require a tmux that can resize its terminal.
skipTestUnlessTmuxCanResize

exitStatus=0

# Perform a test run of the given width and exit on failure.
#
widthTest () {
	terminalWidth="$1"

	testInTerminal "${terminalWidth}" ${generalTimeout} "runTestSubject -h" || return
	# Retry after a short delay, if there's no output and no failure.
	if ! test -s "${workDir}/testOutput"; then
		sleep 1
		testInTerminal "${terminalWidth}" ${generalTimeout} "runTestSubject -h" || return
	fi

	printf '%s: %d\n----\n' 'width' "${terminalWidth}"
	cat "${workDir}/testOutput"
	printf '\n----\n'

	if ! test -s "${workDir}/testOutput"; then
		printf '%s %d: %s\n' 'width' "${terminalWidth}" '-h produced no output'
		exitStatus=1
		return
	elif ! grep -Eq '^U' < "${workDir}/testOutput"; then
		printf '%s %d: %s\n' 'width' "${terminalWidth}" '-h did not produce a Usage line'
		exitStatus=1
		return
	fi

	# Check that lines aren't too long, but for the smaller terminal
	# sizes, omit the "  -x, --long-x" lines from this check because of
	# the way word wrapping has been constrained to not wrap those parts
	# as it would make them unreadable.
	if test "${terminalWidth}" -gt 20; then
		longest="$(awk 'BEGIN{m=0} {x=length($0); if (x>m) m=x} END{print m}' < "${workDir}/testOutput")"
	else
		longest="$(grep -Ev '^  -' < "${workDir}/testOutput" | awk 'BEGIN{m=0} {x=length($0); if (x>m) m=x} END{print m}')"
	fi
	# The word wrapping is limited to a minimum of 5 terminal columns,
	# so accept lines that wide as valid on smaller terminals.
	maxAcceptable="${terminalWidth}"
	test "${terminalWidth}" -lt 5 && maxAcceptable=5
	if test "${longest}" -gt "${maxAcceptable}"; then
		printf '%s:\n' 'Line lengths'
		awk '{printf "%10d %s\n", length($0), $0}' < "${workDir}/testOutput"
		printf '%s %d: %s (%s: %d)\n' 'width' "${terminalWidth}" '-h produced a line that was too long' 'longest' "${longest}"
		exitStatus=1
		return
	fi
}

startSubTest; widthTest 80
startSubTest; widthTest 120
startSubTest; widthTest 400
startSubTest; widthTest 60
startSubTest; widthTest 50
startSubTest; widthTest 40
startSubTest; widthTest 20
startSubTest; widthTest 5
startSubTest; widthTest 1

exit ${exitStatus}
