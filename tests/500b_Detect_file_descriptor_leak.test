#!/bin/sh
#
# Check that valgrind detects file descriptor leaks - this test should fail.
#
# Copyright 2026 Andrew Wood
# License GPLv3+: GNU GPL version 3 or later; see `docs/COPYING'.

error="not set - call this from 'make check'"
true "${sourcePath:?$error}"

testSubject='./checkvalgrind'
useValgrind='1'
orig_f="$f"
export useValgrind orig_f
exec 8>&1

test -n "${sourcePath}" && . "${sourcePath}/tests/test-functions.sh"

# Valgrind earlier than 3.24.0 doesn't treat a leaking file descriptor as an
# error that affects the exit status.
valgrindVersion="$(valgrind --version | cut -d - -f 2 | awk -F . '{print 1000*$1+$2}')"
if test -z "${valgrindVersion}" || ! test "${valgrindVersion}" -gt 3023; then
	skipTest "this valgrind ($(valgrind --version)) may not report leaking file descriptors as an error"
fi

runWithValgrind leak_fd
