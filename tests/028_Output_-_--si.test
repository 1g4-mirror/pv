#!/bin/sh
#
# Check that --si behaves as described in the manual.
#
# Copyright 2026 Andrew Wood
# License GPLv3+: GNU GPL version 3 or later; see `docs/COPYING'.

error="not set - call this from 'make check'"
true "${sourcePath:?$error}"
true "${workDir:?$error}"
test -n "${sourcePath}" && . "${sourcePath}/tests/test-functions.sh"

exitStatus=0

# Write 1000 bytes to a file.
dd if=/dev/zero of="${workDir}/zeroes" bs=1000 count=1 2>/dev/null

# Check that --si affects the way numbers are displayed.
startSubTest
runTestSubject -kXfb < "${workDir}/zeroes" 2>"${workDir}/stderr" \
|| reportFailure 'unexpected non-zero exit status'
tr '\r' '\n' < "${workDir}/stderr" | grep . > "${workDir}/testOutput"
lastLine="$(sed -n '$p' < "${workDir}/testOutput")"
test "${lastLine}" = '1.00kB' || reportFailure 'SI output was not as expected'

# Check that numbers are displayed as expected without --si.
rm -f "${workDir}/testOutput"
startSubTest
runTestSubject -Xfb < "${workDir}/zeroes" 2>"${workDir}/stderr" \
|| reportFailure 'unexpected non-zero exit status'
tr '\r' '\n' < "${workDir}/stderr" | grep . > "${workDir}/testOutput"
lastLine="$(sed -n '$p' < "${workDir}/testOutput")"
test "${lastLine}" = '1000  B' || reportFailure 'non-SI output was not as expected'

# Check that --si affects the way sizes are interpreted.
rm -f "${workDir}/testOutput"
startSubTest
runTestSubject -qkSs 1K /dev/zero > "${workDir}/newZeroes" 2>"${workDir}/stderr" \
|| reportFailure 'unexpected non-zero exit status'
fileSize="$(wc -c < "${workDir}/newZeroes")"
test "${fileSize}" -eq 1000 || reportFailure "SI file size (${fileSize}) was not as expected"

# Check that sizes are interpreted correctly without --si.
rm -f "${workDir}/testOutput" "${workDir}/newZeroes"
startSubTest
runTestSubject -qSs 1K /dev/zero > "${workDir}/newZeroes" 2>"${workDir}/stderr" \
|| reportFailure 'unexpected non-zero exit status'
fileSize="$(wc -c < "${workDir}/newZeroes")"
test "${fileSize}" -eq 1024 || reportFailure "non-SI file size (${fileSize}) was not as expected"

exit ${exitStatus}
