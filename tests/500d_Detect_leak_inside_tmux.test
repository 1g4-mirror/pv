#!/bin/sh
#
# Check that valgrind detects memory leaks when running the test subject
# inside a tmux session - this test should fail.

error="not set - call this from 'make check'"
true "${sourcePath:?$error}"

testSubject='./checkvalgrind'
useValgrind='1'
orig_f="$f"
export useValgrind orig_f
exec 8>&1

test -n "${sourcePath}" && . "${sourcePath}/tests/test-functions.sh"

skipTestUnlessTmuxCanResize

rm -f "${workDir}/message" "${workDir}/failed"
testInTerminal 80 10 "runWithValgrind leak_memory" || exit 1

exit 0
