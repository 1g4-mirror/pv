#!/bin/sh
#
# Check that the terminal width is detected on startup.

error="not set - call this from 'make check'"
true "${sourcePath:?$error}"
true "${workDir:?$error}"
test -n "${sourcePath}" && . "${sourcePath}/tests/test-functions.sh"

# Timeout for each individual test.
generalTimeout='10'

# These tests require a tmux that can resize its terminal.
skipTestUnlessTmuxCanResize

exitStatus=0

# Run a progress meter inside a terminal of the given width, and write the
# longest number of characters seen between "[" and "]" to the file "width"
# under workDir.
#
runWidthTest () {
	terminalWidth="$1"

	testInTerminal "${terminalWidth}" ${generalTimeout} "runTestSubject -pSs 1K </dev/zero >/dev/null" || return

	# Write the length of the longest output line to file "width".
	tr '\r' '\n' < "${workDir}/testOutput" \
	| sed -n 's/^.*\[//;s/\].*$//p' \
	| awk 'BEGIN {m=0} {n=length($0); m=(n>m?n:m)} END {print m}' \
	> "${workDir}/width"
}

# Perform a test run of the given width and exit on failure.  The longest
# bar found by runWidthTest() should be the width of the terminal minus the
# "[] 100%" characters, i.e. 7 less.
#
widthTest () {
	terminalWidth="$1"
	true > "${workDir}/width"
	runWidthTest "${terminalWidth}"
	longestBar=$(cat "${workDir}/width")
	if test -z "${longestBar}"; then
		reportFailure "no output from test at width=${terminalWidth}"
	elif ! test "${longestBar}" -eq $((terminalWidth-7)); then
		reportFailure "bar size incorrect (${longestBar}) at width=${terminalWidth}"
	fi
}

# Test the progress bar width at various terminal sizes.
startSubTest; widthTest 80
startSubTest; widthTest 120
startSubTest; widthTest 400
startSubTest; widthTest 20

exit ${exitStatus}
